pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    cd client
                    npm install
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    cd client
                    npm run build
                '''
            }
        }
    }
}